# Copy to .env for local development. Replace placeholders locally; never commit secrets.
APP_NAME=Lumora Study Companion API
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=500
MAX_PPTX_SLIDES=500
MAX_PPTX_PROCESSING_SIZE_MB=100
MAX_PPTX_ARCHIVE_ENTRIES=10000
MAX_EXTRACTED_CHARS=2000000
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
MAX_MEDIA_DURATION_SECONDS=1800
MAX_EXTRACTED_AUDIO_SIZE_MB=100
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_SECONDS=300
STT_PROVIDER=whisper_compatible
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_API_KEY=replace-with-local-key
STT_MODEL=whisper-1
STT_TIMEOUT_SECONDS=300
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=replace-with-local-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BASE_SECONDS=0.25
EMBEDDING_RETRY_MAX_SECONDS=4
ANSWER_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
